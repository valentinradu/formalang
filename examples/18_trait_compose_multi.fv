// 18 — Trait composition and multi-trait constraints.
// Targets: a trait declared as a sum of two parents (`pub trait Both:
// A + B`), a multi-trait constraint on a generic parameter (`<T: A +
// B>`), and a composed trait used as a single bound — which has to
// reach through the composition to find the parents' methods.
//
// A trait is a constraint, never the type of a value.

pub trait Named {
    name: String
}

pub trait Renderable {
    fn render(self) -> String
}

pub trait NamedRenderable: Named + Renderable {}

pub struct Widget {
    name: String,
    body: String
}

impl Named for Widget {}

impl Renderable for Widget {
    fn render(self) -> String {
        self.body
    }
}

impl NamedRenderable for Widget {}

pub struct Banner {
    name: String,
    body: String
}

impl Named for Banner {}

impl Renderable for Banner {
    fn render(self) -> String {
        self.name + ": " + self.body
    }
}

impl NamedRenderable for Banner {}

// A composed trait works as a bound like any other. It cannot be the
// type of a value: that needs a vtable, and FormaLang dispatches
// statically. One bound, one concrete type per call.
pub fn render_composed<T: NamedRenderable>(item: T) -> String {
    item.render()
}

pub fn render_bounded<T: Named + Renderable>(item: T) -> String {
    item.render()
}

pub fn render_widget() -> String {
    let w = Widget(name: "btn", body: "click me")
    render_composed<Widget>(item: w)
}

pub fn render_banner() -> String {
    let b = Banner(name: "alert", body: "saved")
    render_bounded<Banner>(item: b)
}

pub fn run_checks() {
    assert(condition: render_widget() == "click me")
    assert(condition: render_banner() == "alert: saved")
}
