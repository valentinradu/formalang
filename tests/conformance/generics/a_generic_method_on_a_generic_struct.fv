// expect: run
// A method's own type parameter sits beside the type parameter of its
// impl.

pub struct Box<T> {
    value: T
}

impl Box<T> {
    fn map<U>(self, f: (T) -> U) -> Box<U> {
        Box(value: f(self.value))
    }
}

pub fn run_checks() {
    let b = Box(value: 3).map(f: (v) -> v > 2)
    assert(condition: b.value)
    let s = Box(value: 3).map(f: (v) -> "three")
    assert(condition: s.value == "three")
}
