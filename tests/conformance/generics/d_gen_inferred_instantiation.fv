// expect: run
// docs/user/generics.md: type inference when inferrable.
pub struct Box<T> { value: T }
pub struct Pair<A, B> { first: A, second: B }

pub fn run_checks() {
    let b = Box(value: "inferred as String")
    let s: String = b.value
    let p = Pair(first: 10, second: true)
    let f: I32 = p.first
    assert(condition: s.len() == 18)
    assert(condition: f == 10 && p.second)
}
