// expect: run
// docs/user/expressions.md: either side may be the nil.
pub fn run_checks() {
    let held: I32? = 5
    let empty: I32? = nil
    assert(condition: !(held == nil))
    assert(condition: empty == nil)
    assert(condition: nil == empty)
    assert(condition: held != nil)
    assert(condition: nil != held)
}
