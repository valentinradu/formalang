// expect: run
// Declare the optional and the same body is fine.

pub fn f(n: I32) -> I32? {
    if n > 0 {
        1
    }
}

pub fn run_checks() {
    if let v = f(n: 5) {
        assert(condition: v == 1)
    } else {
        assert(condition: false)
    }
    if let v = f(n: 0) {
        assert(condition: false)
    } else {
        assert(condition: true)
    }
}
