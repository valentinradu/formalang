// expect: run
// docs/user/control-flow.md: chained conditions.
fn f(x: I32) -> I32 {
    if x > 100 { 3 } else if x > 50 { 2 } else { 1 }
}

pub fn run_checks() {
    assert(condition: f(x: 101) == 3)
    assert(condition: f(x: 100) == 2)
    assert(condition: f(x: 51) == 2)
    assert(condition: f(x: 50) == 1)
}
