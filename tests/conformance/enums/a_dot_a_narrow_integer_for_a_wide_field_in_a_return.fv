// expect: reject TypeMismatch
// The leading-dot form gets its enum from the return type of a function.
// The field `h` holds an I64, and `n` is an I32. The full form `Shape.rect(w: 1, h: n)` reports TypeMismatch, so the
// dot form must report it too. See PLAN.md, item 1.

pub enum Shape {
    circle(r: I32),
    rect(w: I32, h: I64),
    empty
}

pub fn make(n: I32) -> Shape {
    .rect(w: 1, h: n)
}
