// expect: reject UnknownField
// The leading-dot form gets its enum from a branch of an `if` that answers the return type.
// The variant `circle` has no field `q`. The full form `Shape.circle(r: 1, q: 2)` reports UnknownField, so the
// dot form must report it too. See PLAN.md, item 1.

pub enum Shape {
    circle(r: I32),
    rect(w: I32, h: I64),
    empty
}

pub fn make(b: Boolean, n: I32) -> Shape {
    if b {
        .circle(r: 1, q: 2)
    } else {
        .empty
    }
}
