// expect: reject UnknownField
// The leading-dot form gets its enum from the value type of an annotated dictionary.
// The variant `circle` has no field `q`. The full form `Shape.circle(r: 1, q: 2)` reports UnknownField, so the
// dot form must report it too. See PLAN.md, item 1.

pub enum Shape {
    circle(r: I32),
    rect(w: I32, h: I64),
    empty
}

pub fn make(n: I32) -> [String: Shape] {
    let d: [String: Shape] = ["a": .circle(r: 1, q: 2)]
    d
}
