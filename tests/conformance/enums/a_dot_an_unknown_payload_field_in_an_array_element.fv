// expect: reject UnknownField
// The leading-dot form gets its enum from the element type of an annotated array.
// The variant `circle` has no field `q`. The full form `Shape.circle(r: 1, q: 2)` reports UnknownField, so the
// dot form must report it too. See PLAN.md, item 1.

pub enum Shape {
    circle(r: I32),
    rect(w: I32, h: I64),
    empty
}

pub fn make(n: I32) -> [Shape] {
    let xs: [Shape] = [.empty, .circle(r: 1, q: 2)]
    xs
}
