// expect: reject TypeMismatch
// The leading-dot form gets its enum from the type of a struct field, at a construction.
// The field `r` holds an I32, not a String. The full form `Shape.circle(r: "x")` reports TypeMismatch, so the
// dot form must report it too. See PLAN.md, item 1.

pub enum Shape {
    circle(r: I32),
    rect(w: I32, h: I64),
    empty
}

pub struct Holder {
    s: Shape
}

pub fn make(n: I32) -> Holder {
    Holder(s: .circle(r: "x"))
}
