// expect: reject EnumVariantWithoutData
// The leading-dot form gets its enum from the type of a struct field, at a construction.
// The variant `empty` holds no data. The full form `Shape.empty(r: 1)` reports EnumVariantWithoutData, so the
// dot form must report it too. See PLAN.md, item 1.

pub enum Shape {
    circle(r: I32),
    rect(w: I32, h: I64),
    empty
}

pub struct Holder {
    s: Shape
}

pub fn make(n: I32) -> Holder {
    Holder(s: .empty(r: 1))
}
