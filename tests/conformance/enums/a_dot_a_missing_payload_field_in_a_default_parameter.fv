// expect: reject MissingField
// The leading-dot form gets its enum from the default value of a parameter.
// The variant `rect` needs the field `h`. The full form `Shape.rect(w: 1)` reports MissingField, so the
// dot form must report it too. See PLAN.md, item 1.

pub enum Shape {
    circle(r: I32),
    rect(w: I32, h: I64),
    empty
}

pub let n: I32 = 2

pub fn take(s: Shape = .rect(w: 1)) -> I32 {
    0
}
