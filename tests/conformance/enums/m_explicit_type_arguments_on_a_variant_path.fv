// expect: run
// A variant path takes explicit type arguments, as a struct
// constructor does: `Box<I32>(value: 42)` in docs/user/generics.md.
// from: swift, where `Optional<Int>.none` is valid.
// Today the parser reads `Maybe<I32>.none` as two comparisons.

pub enum Maybe<T> {
    some(v: T),
    none
}

pub fn is_none(m: Maybe<I32>) -> Boolean {
    match m {
        .some(v): false,
        .none: true
    }
}

pub fn run_checks() {
    let m: Maybe<I32> = Maybe<I32>.none
    assert(condition: is_none(m: m))
    let s: Maybe<I32> = Maybe<I32>.some(v: 1)
    assert(condition: !is_none(m: s))
}
