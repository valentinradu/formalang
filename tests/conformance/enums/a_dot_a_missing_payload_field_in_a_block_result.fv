// expect: reject MissingField
// The leading-dot form gets its enum from the value of a block with an annotation.
// The variant `rect` needs the field `h`. The full form `Shape.rect(w: 1)` reports MissingField, so the
// dot form must report it too. See PLAN.md, item 1.

pub enum Shape {
    circle(r: I32),
    rect(w: I32, h: I64),
    empty
}

pub fn make(n: I32) -> Shape {
    let v: Shape = {
        .rect(w: 1)
    }
    v
}
