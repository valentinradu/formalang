// expect: reject UnknownField
// The leading-dot form gets its enum from the annotation of a module-level `let`.
// The variant `circle` has no field `q`. The full form `Shape.circle(r: 1, q: 2)` reports UnknownField, so the
// dot form must report it too. See PLAN.md, item 1.

pub enum Shape {
    circle(r: I32),
    rect(w: I32, h: I64),
    empty
}

pub let n: I32 = 2
pub let v: Shape = .circle(r: 1, q: 2)
