// expect: reject EnumVariantWithoutData
// The leading-dot form gets its enum from the return type of a function.
// The variant `empty` holds no data. The full form `Shape.empty(r: 1)` reports EnumVariantWithoutData, so the
// dot form must report it too. See PLAN.md, item 1.

pub enum Shape {
    circle(r: I32),
    rect(w: I32, h: I64),
    empty
}

pub fn make(n: I32) -> Shape {
    .empty(r: 1)
}
