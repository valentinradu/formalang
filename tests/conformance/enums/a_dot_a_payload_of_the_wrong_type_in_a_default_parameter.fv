// expect: reject TypeMismatch
// The leading-dot form gets its enum from the default value of a parameter.
// The field `r` holds an I32, not a String. The full form `Shape.circle(r: "x")` reports TypeMismatch, so the
// dot form must report it too. See PLAN.md, item 1.

pub enum Shape {
    circle(r: I32),
    rect(w: I32, h: I64),
    empty
}

pub let n: I32 = 2

pub fn take(s: Shape = .circle(r: "x")) -> I32 {
    0
}
