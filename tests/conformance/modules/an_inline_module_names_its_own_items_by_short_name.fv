// expect: run
// The code of an inline `mod` names the module's own types, enums,
// functions and methods without the module prefix. A module name
// shadows a top-level name, and only inside the module.
pub struct P { y: I32 }

pub mod m {
    pub struct P { x: I32 }

    pub enum E { a, b(n: I32) }

    impl P { fn twice(self) -> I32 { self.x * 2 } }

    pub fn make(x: I32) -> P { P(x: x) }

    pub fn doubled(x: I32) -> I32 { make(x: x).twice() }

    pub fn pick(big: Boolean) -> E { if big { E.b(n: 9) } else { E.a } }

    pub fn payload(e: E) -> I32 { match e { a: 0, b(n): n } }
}

pub fn run_checks() {
    assert(condition: m::doubled(x: 4) == 8)
    assert(condition: m::payload(e: m::pick(big: true)) == 9)
    assert(condition: m::payload(e: m::pick(big: false)) == 0)
    let top = P(y: 3)
    assert(condition: top.y == 3)
}
