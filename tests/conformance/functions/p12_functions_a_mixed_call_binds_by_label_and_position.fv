// expect: run
// docs/user/functions.md: a label binds the argument to the parameter of
// that name, in any order, and an argument with no label takes the
// parameter at its position.
fn sub(a: I32, b: I32) -> I32 { a - b }

pub fn run_checks() {
    assert(condition: sub(b: 1, a: 5) == 4)
    assert(condition: sub(5, 1) == 4)
    assert(condition: sub(5, b: 1) == 4)
}
