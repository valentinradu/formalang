// expect: run
// A call can come before the definition of its function in the file.
// The call still reads the callee's defaults and generic parameters.
pub fn run_checks() {
    assert(condition: add(n: 1) == 6)
    assert(condition: id(v: 2) + 1 == 3)
    assert(condition: apply(f: (x) -> x + 1, v: 2) == 3)
}

fn add(n: I32, m: I32 = 5) -> I32 { n + m }

fn id<T>(v: T) -> T { v }

fn apply<T>(f: (T) -> T, v: T) -> T { f(v) }
