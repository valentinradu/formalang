// expect: run
// A method of a generic struct takes and answers the type argument.
pub struct Box<T> { value: T }
impl Box<T> {
    fn with(self, v: T) -> Box<T> { Box(value: v) }
    fn get(self) -> T { self.value }
    fn pair(self, other: Box<T>) -> T { other.value }
    fn items(self, xs: [T]) -> I32 { xs.len() }
    fn apply(self, f: (T) -> T) -> T { f(self.value) }
}

pub fn run_checks() {
    let b = Box(value: 4).with(v: 6)
    assert(condition: b.get() == 6)
    assert(condition: b.pair(other: Box(value: 8)) == 8)
    assert(condition: b.items(xs: [1, 2, 3]) == 3)
    assert(condition: b.apply(f: (x) -> x * 2) == 12)
}
