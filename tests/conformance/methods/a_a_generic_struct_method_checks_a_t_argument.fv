// expect: reject TypeMismatch
// The receiver is a Box<I32>, so the parameter `v: T` takes an I32.
pub struct Box<T> { value: T }
impl Box<T> {
    fn with(self, v: T) -> Box<T> { Box(value: v) }
    fn get(self) -> T { self.value }
    fn pair(self, other: Box<T>) -> T { other.value }
    fn items(self, xs: [T]) -> I32 { xs.len() }
    fn apply(self, f: (T) -> T) -> T { f(self.value) }
}

pub let b = Box(value: 4).with(v: "s")
