// expect: run
// A method overloads by the shape of the call, the way a free
// function does. `IrExpr::MethodCall` carries a `method_idx` — the
// position of the method inside its impl block — and that is what
// says which of two same-named methods the call means. The name
// beside it is for diagnostics.
//
// This did not work for a long time, and the failure was quiet: the
// index was left at zero until `ResolveReferencesPass` ran, and that
// pass chose by name, so every call reached the first method. A test
// asserted the declaration compiled and never called either one.

pub struct P {
    x: I32
}

impl P {
    fn add(self, n: I32) -> I32 { self.x + n }
    fn add(self, n: I32, m: I32) -> I32 { self.x + n + m }
    fn label(self, text: String) -> String { text }
    fn label(self, value: I32, prefix: String) -> String { prefix }
}

pub fn run_checks() {
    assert(condition: P(x: 1).add(n: 1) == 2)
    assert(condition: P(x: 1).add(n: 1, m: 1) == 3)
    assert(condition: P(x: 1).label(text: "a") == "a")
    assert(condition: P(x: 1).label(value: 1, prefix: "p") == "p")
}
