// expect: run
// docs/user/functions.md: overloads are allowed when their signatures
// differ. These differ in the type of the second parameter.
fn pick(a: I32, b: I32) -> I32 { 1 }
fn pick(a: I32, b: String) -> I32 { 2 }
pub fn run_checks() {
    assert(condition: pick(a: 0, b: 0) == 1)
    assert(condition: pick(a: 0, b: "s") == 2)
}
