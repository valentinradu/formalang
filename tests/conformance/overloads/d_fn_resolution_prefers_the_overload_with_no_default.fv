// expect: run
// docs/user/functions.md: with `f(x: I32)` and `f(x: I32, y: I32 = 1)`,
// `f(5)` resolves to the no-default overload.
fn f(x: I32) -> I32 { 1 }
fn f(x: I32, y: I32 = 1) -> I32 { 2 }

pub fn run_checks() {
    assert(condition: f(x: 5) == 1)
    assert(condition: f(x: 5, y: 1) == 2)
}
