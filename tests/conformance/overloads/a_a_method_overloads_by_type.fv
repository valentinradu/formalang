// expect: run
// docs/user/functions.md, Methods: a method overloads the same way a
// free function does. One label, two types.
pub struct F { tag: I32 }
impl F {
    fn show(self, value: I32) -> String { "number" }
    fn show(self, value: String) -> String { "string" }
}
pub fn run_checks() {
    assert(condition: F(tag: 1).show(value: 1) == "number")
    assert(condition: F(tag: 1).show(value: "a") == "string")
}
