// expect: run
pub fn run_checks() {
    let xs: [I32] = [1, 2, 3, 4, 5]
    assert(condition: for x in xs { x }.take(count: 2).count() == 2)
    assert(condition: for x in xs { x }.skip(count: 2).count() == 3)
    assert(condition: for x in xs { x }.take(count: 99).count() == 5)
    assert(condition: for x in xs { x }.skip(count: 99).count() == 0)
}
