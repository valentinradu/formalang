// expect: run
// docs/user/types.md: you may assign a whole `let mut` binding. An
// assignment inside a branch changes the binding outside the branch.
pub fn run_checks() {
    let mut x: I32 = 1
    let c: Boolean = true
    let unused: I32? = if c { x = 2
        0 }
    assert(condition: x == 2)
}
