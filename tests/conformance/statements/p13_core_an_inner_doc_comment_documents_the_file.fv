// expect: run
//! docs/user/core.md: a `//!` comment at the start of a file documents
//! the file. A plain comment before it does not count.

/// An item doc still attaches to the item.
pub let a: I32 = 1

pub mod m {
    //! A `//!` comment at the start of a `mod` body documents the module.
    pub struct B { value: I32 }
}

pub fn run_checks() {
    assert(condition: a == 1)
}
