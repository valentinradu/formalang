// expect: run
// docs/user/closures.md: a returned closure can capture a `sink`
// parameter, which the function owns, and a module `let`.
pub let base: I32 = 100

fn from_owned(sink step: I32) -> (I32) -> I32 {
    (y) -> y + step + base
}

pub fn run_checks() {
    assert(condition: from_owned(step: 2)(1) == 103)
}
