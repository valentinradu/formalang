// expect: run
// from: go test/closure*.go (capture of a shadowed variable).
// The closure captures the binding visible where the closure is written.
// A later `let` of the same name is a new binding.
pub fn run_checks() {
    let x: I32 = 1
    let g: () -> I32 = () -> x
    let x: I32 = 2
    assert(condition: g() == 1)
    assert(condition: x == 2)
}
