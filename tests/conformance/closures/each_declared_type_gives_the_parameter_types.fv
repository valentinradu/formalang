// expect: run
// A closure parameter with no type takes its type from a declared
// type: a `let` annotation, a parameter, a field, a parameter default,
// a return type, an optional closure slot, or the element type of an
// annotated array. The type goes through `if`, `match` and a block.
struct Button { on_press: (I32) -> I32 }

fn apply(f: (I32) -> I32, to n: I32) -> I32 { f(n) }

fn add_ten() -> (I32) -> I32 { (x) -> x + 10 }

fn chooser(double: Boolean) -> (I32) -> I32 {
    if double { (x) -> x * 2 } else { (x) -> x }
}

fn with_default(f: (I32) -> I32 = (x) -> x + 100) -> I32 { f(1) }

pub fn run_checks() {
    let inc: (I32) -> I32 = (x) -> x + 1
    assert(condition: inc(1) == 2)
    assert(condition: apply(f: (x) -> x * 3, to: 2) == 6)
    let b = Button(on_press: (x) -> x - 1)
    assert(condition: b.on_press(5) == 4)
    let add10 = add_ten()
    assert(condition: add10(1) == 11)
    let double = chooser(double: true)
    assert(condition: double(4) == 8)
    assert(condition: with_default() == 101)
    let curried: (I32) -> (I32) -> I32 = (x) -> (y) -> x + y
    let add1 = curried(1)
    assert(condition: add1(2) == 3)
    let fs: [(I32) -> I32] = [(x) -> x + 1]
    assert(condition: match fs[0] { some(f): f(1) == 2, none: false })
}
