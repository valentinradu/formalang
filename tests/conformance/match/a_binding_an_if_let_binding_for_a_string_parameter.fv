// expect: reject TypeMismatch
// `if let` is a match on `.some(v)` and `.none`, so `v` has the type
// inside the optional. `v` is the I32 inside `o`, and the parameter `s` is a String.
// See docs/user/control-flow.md, `if let`.

pub fn take_string(s: String) -> I32 {
    0
}

pub fn f(o: I32?) -> I32 {
    if let v = o {
        take_string(s: v)
    } else {
        0
    }
}
