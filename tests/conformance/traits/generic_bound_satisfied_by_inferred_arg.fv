// expect: run
// The same call with a type that implements the trait.

pub trait Shape {
    fn area(self) -> I32
}

pub struct Square {
    side: I32
}

impl Shape for Square {
    fn area(self) -> I32 { self.side * self.side }
}

pub fn total<T: Shape>(item: T) -> I32 {
    item.area()
}

pub fn run_checks() {
    assert(condition: total(item: Square(side: 3)) == 9)
}
