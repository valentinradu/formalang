// expect: run
pub trait Shape {
    fn area(self) -> I32
}

pub struct Square {
    side: I32
}

impl Shape for Square {
    fn area(self) -> I32 {
        self.side * self.side
    }
}

pub fn area_of<T: Shape>(shape: T) -> I32 {
    shape.area()
}

pub fn run_checks() {
    assert(condition: area_of(shape: Square(side: 3)) == 9)
}
