// expect: run
pub trait Named {
    name: String
}

pub trait Sized2 {
    size: I32
}

pub trait Both: Named + Sized2 {}

pub struct Widget {
    name: String,
    size: I32
}

impl Named for Widget {}
impl Sized2 for Widget {}
impl Both for Widget {}

pub fn run_checks() {
    let w = Widget(name: "w", size: 2)
    assert(condition: w.name == "w")
    assert(condition: w.size == 2)
}
