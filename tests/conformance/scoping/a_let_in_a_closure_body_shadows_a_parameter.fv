// expect: run
// A `let` inside a closure body shadows a parameter of the same name.
pub fn run_checks() {
    let g = (f: (String) -> String) -> {
        let f = (y: I32) -> y + 1
        f(1)
    }
    assert(condition: g((s) -> s) == 2)
    let h = (x: String) -> {
        let x = 1
        x + 1
    }
    assert(condition: h("s") == 2)
}
